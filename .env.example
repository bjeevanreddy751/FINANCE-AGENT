# FinanceIQ Environment Configuration

# OpenAI API (recommended for best results)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Alternative: Anthropic (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL_NAME=claude-3-haiku-20240307

# Alternatively: Ollama for local LLM (no API key needed)
# Use local_llm mode in config

# Application settings
ENVIRONMENT=development
DEBUG=false

# Note: Get OpenAI API key from https://platform.openai.com/api-keys
# For demo mode without API key, the app will work with rule-based features
# and provide sample data analysis without AI-generated recommendations
